# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# Environment variables and configuration
.env
.env.*
server/.env
server/config/LOCAL_default.json
server/config/default.local.js
scripts/**/*

# Dependencies
node_modules
server/node_modules
npm-debug.log*
yarn-debug.log*
yarn-error.log*
package-lock.json
yarn.lock

# Testing
coverage
server/coverage

# Logs
logs
*.log

# Runtime data
pids
*.pid
*.seed
*.pid.lock

# Docker
.dockerignore
docker-compose.override.yml

# IDE and editor files
.idea
.vscode
*.swp
*.swo
.DS_Store
.project
.classpath
.settings/
*.sublime-workspace
*.sublime-project

# Temporary files
.tmp
.temp
tmp/
temp/

# Generated documentation
server/docs
server/schema-docs

# Optional: Keep client references for future use but commented out
# /client/node_modules
# /client/build
# /client/.env
